<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base obsidian card with rounded corners -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF050508" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Subtle top-right living ambient blue aura -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="225"
                android:centerX="0.88"
                android:centerY="0.12"
                android:endColor="#00050508"
                android:gradientRadius="160dp"
                android:startColor="#1E0A84FF"
                android:type="radial" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Subtle bottom-left crimson ambient aura -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:centerX="0.14"
                android:centerY="0.86"
                android:endColor="#00050508"
                android:gradientRadius="140dp"
                android:startColor="#10FA114F"
                android:type="radial" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Crisp hairline subtle border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
</layer-list>
