<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_glow"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="12dp"
    android:paddingEnd="14dp"
    android:paddingStart="12dp"
    android:paddingTop="12dp">

    <!-- Big glowing Activity Rings; tap to flip groups when multiple exist -->
    <ImageView
        android:id="@+id/widget_rings_image"
        android:layout_width="136dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_name"
        android:scaleType="fitCenter" />

    <FrameLayout
        android:id="@+id/widget_rings_right_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:text="NO HABITS YET"
            android:textAllCaps="true"
            android:textColor="#5971717A"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_habits_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <!-- Live status pill + chunk switcher -->
            <LinearLayout
                android:id="@+id/widget_rings_meta_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_rings_today_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_pill_bg"
                    android:letterSpacing="0.08"
                    android:paddingBottom="2dp"
                    android:paddingEnd="7dp"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:text="0/0 TODAY"
                    android:textColor="#FF0A84FF"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/widget_rings_pager"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_pill_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="2dp"
                    android:paddingEnd="4dp"
                    android:paddingStart="4dp"
                    android:paddingTop="2dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/widget_rings_prev_btn"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Previous rings"
                        android:padding="2dp"
                        android:src="@drawable/ic_widget_chevron_left" />

                    <TextView
                        android:id="@+id/widget_rings_page_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="4dp"
                        android:paddingStart="4dp"
                        android:text="1/2"
                        android:textColor="#FFA1A1AA"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/widget_rings_next_btn"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Next rings"
                        android:padding="2dp"
                        android:src="@drawable/ic_widget_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <!-- Habit 1 -->
            <LinearLayout
                android:id="@+id/widget_habit_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_habit_1_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAllCaps="true"
                        android:textColor="#FFFA114F"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/widget_habit_1_done_icon"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_widget_habit_done"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_habit_1_cat_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_habit_1_cat_icon"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_habit_1_cat_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:letterSpacing="0.14"
                        android:maxLines="1"
                        android:textAllCaps="true"
                        android:textColor="#FF71717A"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Habit 2 -->
            <LinearLayout
                android:id="@+id/widget_habit_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_habit_2_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAllCaps="true"
                        android:textColor="#FF92FF00"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/widget_habit_2_done_icon"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_widget_habit_done"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_habit_2_cat_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_habit_2_cat_icon"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_habit_2_cat_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:letterSpacing="0.14"
                        android:maxLines="1"
                        android:textAllCaps="true"
                        android:textColor="#FF71717A"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Habit 3 -->
            <LinearLayout
                android:id="@+id/widget_habit_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_habit_3_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAllCaps="true"
                        android:textColor="#FF00F2FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/widget_habit_3_done_icon"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_widget_habit_done"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_habit_3_cat_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_habit_3_cat_icon"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_habit_3_cat_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:letterSpacing="0.14"
                        android:maxLines="1"
                        android:textAllCaps="true"
                        android:textColor="#FF71717A"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
